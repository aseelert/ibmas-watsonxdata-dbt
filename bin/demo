#!/usr/bin/env bash
# Stable, customer-facing entry point for the watsonx.data lakehouse demo.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

usage() {
  cat <<'EOF'
Usage: bin/demo <command> [args...]

Docker lifecycle (run in order on first use):
  docker build          Build the two custom images (Airflow + Flink).
                        Run once after cloning; re-run after a git pull
                        that changes a Dockerfile or requirements.txt.
  docker start [svc...] Start Docker services. With no arguments starts ALL
                        services (metabase, airflow, lineage, catalog, streaming).
                        Pass one or more names to start only those:
                          metabase  airflow  lineage  catalog  streaming
  docker stop  [svc...] Stop services (same names as start; default: all).
  docker status         Show running state of all demo containers.

  NOTE: dbt and spark talk directly to watsonx.data -- they do NOT need
        Docker. Start Docker services only for the optional UIs.

Demo commands:
  doctor               Check .env, connection JSON, CA cert, token and Docker.
                        Read-only; prints warnings with the exact fix.
  setup                Refresh .env: login, API key, bearer token, derived
                        endpoints/certs. Run first, every session.
  dbt <args...>         Run dbt (dbt build, dbt seed, dbt debug, ...)
  spark [args...]       Upload + submit the Spark medallion job.
                        Pass --dry-run or --validate-config to preview.
  ingest [args...]      Run the cpdctl native-ingestion path (raw only).
                        Add --wait to block until the batch finishes.
  streaming [args...]   Confluent pipeline orchestrator (Kafka/Flink/Iceberg).
                        No args = full bring-up; pass --silver / --gold /
                        --status / --reset / --stop for one stage.
                        NOTE: use 'docker start streaming' to start
                        containers only; this command runs the full pipeline.
  catalog               Run OpenMetadata ingestion (containers must be
                        running; use 'docker start catalog' first).
  governance [args...]  Provision the IBM Knowledge Catalog governance model
                        (categories, terms, data classes, rules) in CPD.
                        Try --verify-only or --dry-run first; --stage X for one.
  query [args...]       Read the dbt Gold marts.
  validate [args...]    Compare Gold outputs across dbt/Spark/Confluent.
  reset [args...]       Safely reset demo resources (use --dry-run first).

Typical session:
  bin/demo setup                    # refresh credentials (every session)
  bin/demo dbt build                # no Docker needed
  bin/demo docker start             # start ALL services (or pick one)
  bin/demo docker status            # verify all containers are running
  bin/demo validate                 # compare Gold across paths
EOF
}

# ---------------------------------------------------------------------------
# Helpers used by docker start/stop
# ---------------------------------------------------------------------------
_docker_start_metabase() {
  echo "==> Starting Metabase (port 3000)..."
  docker compose up -d metabase-postgres metabase metabase-provision
}
# ---------------------------------------------------------------------------
# After `bin/demo setup` rewrote .env: containers only read .env when they are
# CREATED, so a changed Presto host / API key / instance id / MinIO endpoint /
# MinIO keys leaves running containers on the OLD values. We fingerprint the
# values each stack really depends on before and after setup and recreate only
# what is affected (NOT on every run: the Spark bearer token changes each time
# but nothing running uses it, so a plain re-run restarts nothing).
#   presto group  -> Metabase data source (re-provisioned) + Airflow
#   s3 group      -> Iceberg REST + Flink JobManager/TaskManager/SQL gateway
# ---------------------------------------------------------------------------
_PRESTO_KEYS="WXD_HOST WXD_PORT WXD_USER WXD_API_KEY WXD_INSTANCE_ID WXD_CATALOG WXD_PRESTO_ENGINE_ID WXD_SPARK_ENGINE_ID WXD_CPD_HOST"
_S3_KEYS="WXD_OBJECT_STORE_ENDPOINT WXD_OBJECT_STORE_ACCESS_KEY WXD_OBJECT_STORE_SECRET_KEY WXD_OBJECT_STORE_REGION CONFLUENT_SILVER_SCHEMA"

_env_fp() {  # _env_fp KEY... -> hash of the KEY=VALUE lines currently in .env
  local k
  for k in "$@"; do grep -E "^${k}=" .env 2>/dev/null | head -1 | sed -E 's/[[:space:]]+#.*$//'; done | shasum | cut -d' ' -f1
}

_running_svcs() {  # _running_svcs name... -> those of the names that are running
  local want="$*" r s out=""
  r=$(docker compose ps --services --status running 2>/dev/null)
  for s in $want; do echo "$r" | grep -qx "$s" && out="$out $s"; done
  echo "$out"
}

_refresh_after_setup() {  # args: <presto-fp-before> <s3-fp-before>
  command -v docker >/dev/null 2>&1 || return 0
  local p_before="$1" s_before="$2" svcs
  local p_after s_after; p_after=$(_env_fp $_PRESTO_KEYS); s_after=$(_env_fp $_S3_KEYS)

  # Metabase: always re-run the provisioner (cheap, idempotent) so the Presto
  # data source can never keep a stale host/key.
  if [ -n "$(_running_svcs metabase)" ]; then
    echo "==> Refreshing the Metabase Presto data source from .env..."
    docker compose up -d --force-recreate metabase-provision >/dev/null 2>&1 \
      && docker wait ibmas-watsonxdata-dbt-metabase-provision-1 >/dev/null 2>&1 \
      && docker logs --tail 3 ibmas-watsonxdata-dbt-metabase-provision-1 2>&1 | sed 's/^/    /' \
      || echo "    (could not refresh Metabase — run: bin/demo docker start metabase)"
  fi

  if [ "$p_before" != "$p_after" ]; then
    svcs=$(_running_svcs airflow-webserver airflow-scheduler airflow-dag-processor)
    if [ -n "$svcs" ]; then
      echo "==> Presto/API values changed — recreating:$svcs"
      docker compose up -d --force-recreate --no-deps $svcs 2>&1 | grep -v level=warning | sed 's/^/    /' | tail -3
    fi
  fi

  if [ "$s_before" != "$s_after" ]; then
    svcs=$(_running_svcs confluent-iceberg-rest confluent-flink-jobmanager confluent-flink-taskmanager confluent-flink-sql-gateway)
    if [ -n "$svcs" ]; then
      echo "==> Object-store values changed — recreating:$svcs"
      docker compose up -d --force-recreate --no-deps $svcs 2>&1 | grep -v level=warning | sed 's/^/    /' | tail -4
      echo "    NOTE: Flink jobs were restarted with the container — resubmit them: bin/demo streaming --silver"
    fi
  fi
  return 0
}
_docker_start_airflow() {
  echo "==> Starting Airflow (port 8082)..."
  docker compose up -d airflow-init
  docker compose up -d airflow-webserver airflow-scheduler airflow-dag-processor
}
_docker_start_lineage() {
  echo "==> Starting Marquez / OpenLineage (ports 3001, 5010)..."
  docker compose up -d marquez-db marquez-api marquez-web
}
# OpenMetadata encrypts stored connection secrets with a Fernet key. We never
# commit one: it is generated once per machine into the git-ignored .env.
# Existing catalog DB + no key => refuse (a new key could not decrypt it).
_ensure_om_secrets() {
  [ -f .env ] || return 0
  grep -qE '^OM_FERNET_KEY=.+' .env && return 0
  if [ -n "$(ls -A 07-openmetadata/openmetadata/docker-volume/db-data 2>/dev/null)" ]; then
    echo "!! An OpenMetadata database already exists but OM_FERNET_KEY is not in .env." >&2
    echo "   Set OM_FERNET_KEY=<the key it was created with> in .env, or reset the catalog:" >&2
    echo "   bin/demo docker stop catalog && rm -rf 07-openmetadata/openmetadata/docker-volume/db-data" >&2
    return 1
  fi
  echo "OM_FERNET_KEY=$(python3 -c 'import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())')" >> .env
  echo "==> Generated OM_FERNET_KEY in .env (OpenMetadata secret-encryption key)."
}
_docker_start_catalog() {
  echo "==> Starting OpenMetadata (port 8585)..."
  _ensure_om_secrets || exit 1
  docker compose up -d mysql elasticsearch execute-migrate-all openmetadata-server ingestion
}
_docker_start_streaming() {
  echo "==> Starting Confluent / Flink / Iceberg (ports 29092, 28080-28085, 28181)..."
  # start.sh --stack = MinIO HTTPS route + Java truststore (cluster CA) + the 7 services.
  bash 04-confluent-streaming/confluent/start.sh --stack
}

_docker_stop_metabase()   { docker compose stop metabase metabase-postgres metabase-provision; }
_docker_stop_airflow()    { docker compose stop airflow-webserver airflow-scheduler airflow-dag-processor airflow-init; }
_docker_stop_lineage()    { docker compose stop marquez-web marquez-api marquez-db; }
_docker_stop_catalog()    { docker compose stop ingestion openmetadata-server execute-migrate-all elasticsearch mysql; }
_docker_stop_streaming()  { docker compose stop confluent-flink-sql-gateway confluent-flink-taskmanager confluent-flink-jobmanager confluent-iceberg-rest confluent-kafbat-ui confluent-schema-registry confluent-kafka; }

# ---------------------------------------------------------------------------
# Soft preflight: WARN (never fail) and pause 5 s so a person or an agent
# notices. Silence with WXD_SKIP_PREFLIGHT=1. 'dbt' has its own in 02_dbt_env.sh.
# ---------------------------------------------------------------------------
PF_WARNINGS=0
_pf_warn() { PF_WARNINGS=$((PF_WARNINGS+1)); echo "  ⚠  $*" >&2; }
_env_val() {
  grep -E "^$1=" .env 2>/dev/null | head -1 | cut -d= -f2- \
    | sed -E 's/[[:space:]]+#.*$//; s/^["'"'"']//; s/["'"'"']$//'
}
_is_unset() { [[ -z "$1" || "$1" =~ ^(replace-with-|your-|changeme|todo|placeholder|\<) ]]; }

_pf_env() {   # $1 = "wait" to pause 5 s when something is wrong
  local before=$PF_WARNINGS v
  if [[ ! -f .env ]]; then
    _pf_warn ".env is missing -> run: cp .env.example .env && bin/demo setup  (set WXD_OC_PASSWORD first)"
  else
    for v in WXD_HOST WXD_INSTANCE_ID WXD_API_KEY; do
      if _is_unset "$(_env_val $v)"; then
        _pf_warn "$v is empty or still a placeholder in .env -> run: bin/demo setup"
      fi
    done
  fi
  if [[ ! -f watsonx_data/instance_details.json ]]; then
    _pf_warn "watsonx_data/instance_details.json missing -> 'bin/demo setup' builds it from the cluster if 'oc' is logged in; otherwise export it from the watsonx.data UI (Infrastructure > Engines > Presto > Connection info)"
  elif [[ -f .env ]]; then
    local jid jhost
    jid=$(python3 - <<'PY' 2>/dev/null
import json
d={x["name"]:x["value"] for x in json.load(open("watsonx_data/instance_details.json"))["properties"]["connection"]}
print(d.get("instance_id",""), d.get("engine_host",""))
PY
)
    jhost=${jid#* }; jid=${jid%% *}
    if [[ -n "$jid" && "$jid" != "$(_env_val WXD_INSTANCE_ID)" ]] || [[ -n "$jhost" && "$jhost" != "$(_env_val WXD_HOST)" ]]; then
      _pf_warn ".env and watsonx_data/instance_details.json disagree (instance/host) -> run: bin/demo setup --overwrite"
    fi
  fi
  [[ -f certs/watsonxdata-ca.pem ]] || _pf_warn "certs/watsonxdata-ca.pem missing (TLS will fail) -> run: bin/demo setup"
  if [[ $PF_WARNINGS -gt $before && "${1:-}" == "wait" ]]; then
    echo "  Continuing in 5 s (WXD_SKIP_PREFLIGHT=1 silences this)..." >&2; sleep 5
  fi
}

_pf_docker() {
  local before=$PF_WARNINGS
  if ! command -v docker >/dev/null 2>&1; then
    _pf_warn "no 'docker' CLI found. Needed ONLY for Metabase, lineage, Airflow, catalog, streaming (dbt/Spark/ingest do not need it)"
  elif ! docker info >/dev/null 2>&1; then
    _pf_warn "Docker is installed but not running. Needed ONLY for Metabase, lineage, Airflow, catalog, streaming -> start Docker Desktop / OrbStack / Podman"
  fi
  if [[ $PF_WARNINGS -gt $before && "${1:-}" == "wait" ]]; then
    echo "  Continuing in 5 s (WXD_SKIP_PREFLIGHT=1 silences this)..." >&2; sleep 5
  fi
}

if [[ "${WXD_SKIP_PREFLIGHT:-}" != "1" ]]; then
  case "${1:-}" in
    spark|ingest|query|validate|reset|streaming|governance) _pf_env wait ;;
  esac
  case "${1:-}" in
    streaming|metabase|airflow|lineage|catalog) _pf_docker wait ;;
    docker) [[ "${2:-}" == "build" || "${2:-}" == "start" ]] && _pf_docker wait ;;
  esac
fi

# ---------------------------------------------------------------------------
case "${1:-}" in
  doctor)
    echo "==> bin/demo doctor (read-only)"
    _pf_env; _pf_docker
    if [[ -x .venv/bin/python3 && -f scripts/refresh_token.py ]]; then .venv/bin/python3 scripts/refresh_token.py --check 2>&1 | tail -2 || true; fi
    if [[ $PF_WARNINGS -eq 0 ]]; then echo "  ✓ no problems found"; else echo "  $PF_WARNINGS warning(s) above; none are fatal by themselves."; fi
    ;;
  docker)
    subcmd="${2:-}"
    shift 2 || shift || true
    case "$subcmd" in
      build)
        echo "==> Building Airflow image (05-airflow/airflow/Dockerfile)..."
        docker compose build airflow-webserver airflow-scheduler airflow-dag-processor airflow-init
        echo "==> Building Flink image wxd-flink:1.20 (04-confluent-streaming/confluent/flink/Dockerfile)..."
        docker build -t wxd-flink:1.20 04-confluent-streaming/confluent/flink
        echo "==> Done. Both custom images are ready."
        ;;
      start)
        svcs=("$@")
        [[ ${#svcs[@]} -eq 0 ]] && svcs=(metabase airflow lineage catalog streaming)
        for svc in "${svcs[@]}"; do
          case "$svc" in
            metabase)  _docker_start_metabase  ;;
            airflow)   _docker_start_airflow   ;;
            lineage)   _docker_start_lineage   ;;
            catalog)   _docker_start_catalog   ;;
            streaming) _docker_start_streaming ;;
            *) echo "Unknown service: $svc (valid: metabase airflow lineage catalog streaming)" >&2; exit 2 ;;
          esac
        done
        ;;
      stop)
        svcs=("$@")
        [[ ${#svcs[@]} -eq 0 ]] && svcs=(metabase airflow lineage catalog streaming)
        for svc in "${svcs[@]}"; do
          case "$svc" in
            metabase)  _docker_stop_metabase  ;;
            airflow)   _docker_stop_airflow   ;;
            lineage)   _docker_stop_lineage   ;;
            catalog)   _docker_stop_catalog   ;;
            streaming) _docker_stop_streaming ;;
            *) echo "Unknown service: $svc (valid: metabase airflow lineage catalog streaming)" >&2; exit 2 ;;
          esac
        done
        ;;
      status)
        # All stacks share the same project name (ibmas-watsonxdata-dbt) so
        # one 'docker compose ps' from the root compose shows everything.
        echo "==> Demo container status (project: ibmas-watsonxdata-dbt):"
        docker compose ps 2>/dev/null || true
        ;;
      '') echo "Usage: bin/demo docker <build|start|stop|status>" >&2; exit 2 ;;
      *)  echo "Unknown docker subcommand: $subcmd" >&2
          echo "Usage: bin/demo docker <build|start|stop|status>" >&2; exit 2 ;;
    esac
    ;;
  setup)
    shift
    _fp_p=$(_env_fp $_PRESTO_KEYS); _fp_s=$(_env_fp $_S3_KEYS)
    python3 scripts/00a_prepare_watsonx_env.py "$@" || exit $?
    # .env just changed (new API key, Presto host/engine id, ...). Anything that
    # copied those values at start-up is now stale — refresh it automatically.
    case " $* " in *" --dry-run "*|*" -h "*|*" --help "*) ;; *) _refresh_after_setup "$_fp_p" "$_fp_s" ;; esac
    ;;
  dbt) shift; exec bash scripts/02_dbt_env.sh "$@" ;;
  # Legacy aliases kept so existing notes/muscle-memory still work:
  metabase)  _docker_start_metabase ;;
  airflow)   _docker_start_airflow  ;;
  lineage)   _docker_start_lineage  ;;
  catalog)
    # Legacy: start containers then run ingestion (same as old behaviour)
    _docker_start_catalog
    bash 07-openmetadata/openmetadata/ingestion/run-ingestion.sh
    ;;
  spark)
    shift
    python3 scripts/03a_upload_spark_assets.py
    exec python3 scripts/03b_submit_spark_application.py "$@"
    ;;
  ingest) shift; exec python3 scripts/04_ingest_with_cpdctl.py "$@" ;;
  governance) shift; exec python3 scripts/06b_provision_ikc_governance.py "$@" ;;
  query) shift; exec python3 scripts/05_query_gold.py "$@" ;;
  streaming) shift; exec bash 04-confluent-streaming/confluent/start.sh "$@" ;;
  validate) shift; exec python3 scripts/reconcile_gold.py "$@" ;;
  reset) shift; exec bash scripts/11_reset_demo.sh "$@" ;;
  -h|--help|help|'') usage ;;
  *) echo "Unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
