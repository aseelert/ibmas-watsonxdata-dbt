# Local audit/scratch output (see AUDIT_REPORT.md)
AUDIT_REPORT.md

# CLI install artifacts (downloaded in setup Step 8; binaries go to ~/.local/bin)
cpdctl.tar.gz
oc.tar.gz
oc.zip

# TLS certificates — cluster-specific, auto-generated by scripts/00a_prepare_watsonx_env.py
# Never commit real certs; the *.pem files contain cluster hostnames and CA chains.
# Re-generate with: python scripts/00a_prepare_watsonx_env.py
certs/*.pem
certs/*.crt
certs/*.key
**/truststore.jks

# Connection-export JSON (same cluster-specific cert-chain/hostname payload as the
# watsonx_data/*.json rule above, just saved under certs/ by some export flows).
certs/*.json
watsonx_data/*.json.bck

# macOS Finder metadata / Office lock files — never worth tracking.
.DS_Store
**/.DS_Store
~$*
